{
  "name": "desktop",
  "private": true,
  "version": "0.0.0",
  "description": "Maava desktop client — discover, install, and launch AI tools and agents.",
  "author": {
    "name": "Portdex",
    "email": "rajdeepverma2020@gmail.com"
  },
  "homepage": "https://github.com/Maavacommunity/maava",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsc -p tsconfig.json && electron .",
    "build": "tsc -p tsconfig.json",
    "package": "pnpm run build && electron-builder",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "typescript": "^5.5.0"
  },
  "build": {
    "appId": "com.portdex.maava",
    "productName": "Maava",
    "publish": null,
    "protocols": {
      "name": "Maava Install Link",
      "schemes": ["maava"]
    },
    "files": ["dist/**/*", "static/**/*"],
    "extraResources": [{ "from": "agents", "to": "agents" }],
    "directories": {
      "output": "release"
    },
    "mac": { "target": ["dmg", "zip"], "category": "public.app-category.developer-tools" },
    "win": { "target": ["nsis"] },
    "linux": { "target": ["AppImage", "deb"], "category": "Development" }
  }
}
